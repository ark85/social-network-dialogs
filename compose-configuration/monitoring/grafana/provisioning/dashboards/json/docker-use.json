{
  "uid": "IWqULAigz",
  "title": "Docker USE",
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 5,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "zabbix"
        },
        "query": {
          "queryType": "host",
          "group": "/.*/",
          "host": "/.*/",
          "application": "",
          "item": ""
        },
        "refresh": 1,
        "includeAll": false,
        "regex": "/social-network-dialogs-backend/"
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "zabbix"
        },
        "query": {
          "queryType": "itemTag",
          "group": "/.*/",
          "host": "/.*/",
          "application": "/Docker: Container .*/",
          "item": "/.*/",
          "itemTag": "/.*container/"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allowCustomValue": false,
        "regex": "/container:\\s*(.*)/gm"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU utilization",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "zabbix" },
          "queryType": "0",
          "resultFormat": "time_series",
          "schema": 12,
          "group": { "filter": "/.*/" },
          "host": { "filter": "$host" },
          "application": { "filter": "$container" },
          "itemTag": { "filter": "$container" },
          "item": { "filter": "/($container:\\ CPU percent usage)/" },
          "functions": []
        }
      ]
    },
    {
      "id": 2,
